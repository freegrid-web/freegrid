{
  "name": "freegrid-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @freegrid/sheet build",
    "test": "pnpm --filter @freegrid/sheet test",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @freegrid/sheet typecheck",
    "docs:dev": "pnpm --filter @freegrid/docs dev",
    "docs:build": "pnpm --filter @freegrid/docs build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
