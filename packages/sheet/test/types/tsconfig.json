{
  "compilerOptions": {
    "lib": [
      "es2020",
      "dom"
    ],
    "module": "commonjs",
    "noEmit": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "",
    "paths": {
      "handsontable": [ "../../types/compat" ]
    }
  },
  "include": [
    "../../types/compat.d.ts",
    "legacy-dom.d.ts",
    "**/*.types.ts",
    "../../src/plugins/**/test/*.types.ts"
  ]
}
